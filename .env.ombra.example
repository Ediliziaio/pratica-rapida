# CRM OMBRA — copia in `.env.ombra` (ignorato da git) e avvia con: npx vite --mode ombra
#
# Chiavi del SECONDO progetto Supabase (quello ombra), MAI quelle di produzione.
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# Accende la modalità ombra: striscia OMBRA in alto, pagine /admin/domande-apr
# e /admin/comunicazioni-bloccate. Senza questa riga l'app è il CRM vero.
VITE_CRM_OMBRA=true

# Server locale delle domande APR (facoltativo, questo è il default).
VITE_CRM_OMBRA_DOMANDE_URL="http://127.0.0.1:8790"
