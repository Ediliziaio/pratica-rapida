{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "baseUrl": "../..",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": { "@/*": ["src/*"] },
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node", "vitest/globals"]
  },
  "include": ["./**/*.ts"]
}
